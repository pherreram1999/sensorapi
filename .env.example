# libSQL remote (Turso or compatible)
DATABASE_URL=libsql://<db-name>-<org>.turso.io
DATABASE_AUTH_TOKEN=<your-turso-token>

# Server
PORT=8080
HOST=0.0.0.0

# API key for POST /api/readings (sensor writes only)
# Use "X-API-Key: <value>" or "Authorization: Bearer <value>"
API_SECRET_KEY=change-me-long-random-string

# Default polling interval in ms shown in the dashboard
DEFAULT_POLL_MS=3000
